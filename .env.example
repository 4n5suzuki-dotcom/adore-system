# Supabase プロジェクトの設定値をコピーして .env.local に貼り付けてください
# 値はダミーです。実際のプロジェクト値に置き換えてください。

# Supabase プロジェクト URL（例: https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon（publishable）キー
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 店舗（テナント）UUID … tenants テーブルの id
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000

# 面接フォーム案内（QR）の表示先 URL … 公開の応募フォーム(/interview)の入口
# 未設定時は本番 URL（https://adore-system-psja.vercel.app/interview）にフォールバック
NEXT_PUBLIC_INTERVIEW_FORM_URL=https://adore-system-psja.vercel.app/interview
